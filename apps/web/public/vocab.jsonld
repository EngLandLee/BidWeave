{
  "@context": {
    "bw": "https://englandlee.github.io/BidWeave/vocab.jsonld#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@id": "https://englandlee.github.io/BidWeave/vocab.jsonld",
  "@type": "owl:Ontology",
  "dcterms:title": "BidWeave private evidence graph vocabulary",
  "dcterms:license": {"@id": "https://www.apache.org/licenses/LICENSE-2.0"},
  "rdfs:comment": "These terms describe internal bid-response records, not contracting-authority procedures or legal certification. Graph identifiers name tenant-private Fuseki graphs; publishing this vocabulary does not publish their contents. Public TED source graphs retain their original identifiers and licensing.",
  "@graph": [
    {"@id": "bw:BidCase", "@type": "rdfs:Class", "rdfs:label": "An organization's bid-response case"},
    {"@id": "bw:Revision", "@type": "rdfs:Class", "rdfs:label": "Immutable requirements revision"},
    {"@id": "bw:Requirement", "@type": "rdfs:Class", "rdfs:label": "A version-scoped response requirement"},
    {"@id": "bw:Approval", "@type": "rdfs:Class", "rdfs:label": "Independent workflow review decision"},
    {"@id": "bw:NoticeReference", "@type": "rdfs:Class", "rdfs:label": "Local reference to a public TED notice source graph"},
    {"@id": "bw:tenant", "@type": "rdf:Property", "rdfs:label": "Owning tenant identifier"},
    {"@id": "bw:currentRevision", "@type": "rdf:Property", "rdfs:label": "Current revision resource"},
    {"@id": "bw:hasRevision", "@type": "rdf:Property", "rdfs:label": "Historical or current revision resource"},
    {"@id": "bw:revision", "@type": "rdf:Property", "rdfs:label": "Revision to which the record belongs"},
    {"@id": "bw:revisionNumber", "@type": "rdf:Property", "rdfs:label": "Monotonic revision number within the case"},
    {"@id": "bw:uuid", "@type": "rdf:Property", "rdfs:label": "Internal immutable record identifier"},
    {"@id": "bw:submissionDeadline", "@type": "rdf:Property", "rdfs:label": "ISO 8601 response deadline in this revision"},
    {"@id": "bw:createdBy", "@type": "rdf:Property", "rdfs:label": "Actor who created the revision"},
    {"@id": "bw:filename", "@type": "rdf:Property", "rdfs:label": "Original evidence filename"},
    {"@id": "bw:sha256", "@type": "rdf:Property", "rdfs:label": "SHA-256 digest of original evidence bytes"},
    {"@id": "bw:requirementKey", "@type": "rdf:Property", "rdfs:label": "Stable requirement key addressed by evidence"},
    {"@id": "bw:verified", "@type": "rdf:Property", "rdfs:label": "Whether independent verification has been recorded for this revision"},
    {"@id": "bw:verifiedBy", "@type": "rdf:Property", "rdfs:label": "Independent verifier actor"},
    {"@id": "bw:quantity", "@type": "rdf:Property", "rdfs:label": "Asserted count subject to independent verification"},
    {"@id": "bw:validUntil", "@type": "rdf:Property", "rdfs:label": "Asserted ISO 8601 evidence expiry subject to verification"},
    {"@id": "bw:key", "@type": "rdf:Property", "rdfs:label": "Stable requirement key within the case"},
    {"@id": "bw:kind", "@type": "rdf:Property", "rdfs:label": "Requirement validation kind"},
    {"@id": "bw:mandatory", "@type": "rdf:Property", "rdfs:label": "Whether this requirement blocks submission"},
    {"@id": "bw:sourceRef", "@type": "rdf:Property", "rdfs:label": "Human-reviewable source section or document anchor"},
    {"@id": "bw:owner", "@type": "rdf:Property", "rdfs:label": "Responsible person or team label"},
    {"@id": "bw:hasEvidence", "@type": "rdf:Property", "rdfs:label": "Evidence record linked to the same requirement and revision"},
    {"@id": "bw:minimum", "@type": "rdf:Property", "rdfs:label": "Minimum required count"},
    {"@id": "bw:decision", "@type": "rdf:Property", "rdfs:label": "Approve or reject decision"},
    {"@id": "bw:comment", "@type": "rdf:Property", "rdfs:label": "Recorded reviewer rationale"},
    {"@id": "bw:public", "@type": "rdf:Property", "rdfs:label": "Whether the referenced upstream source is public"},
    {"@id": "bw:publicationNumber", "@type": "rdf:Property", "rdfs:label": "TED publication identifier"},
    {"@id": "bw:sourceGraph", "@type": "rdf:Property", "rdfs:label": "Upstream named graph resolved by a live TED query"},
    {"@id": "bw:retrievedAt", "@type": "rdf:Property", "rdfs:label": "ISO 8601 retrieval time of the public metadata"}
  ]
}
